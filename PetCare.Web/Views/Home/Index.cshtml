@{
    ViewData["Title"] = "Начало";
}

<div class="text-center py-5">
    <h1 class="display-4">PetCare – Ветеринарна клиника</h1>
    <p class="lead">
        Записване на часове за преглед и медицинска история за домашни любимци.
    </p>

    <a asp-controller="Veterinarians" asp-action="Index" class="btn btn-primary">
        Виж ветеринарите
    </a>

    @if (User.IsInRole("User"))
    {
        <a asp-controller="MyAppointments" asp-action="Index" class="btn btn-outline-primary">
            Моите часове
        </a>
    }

    @if (User.IsInRole("Administrator"))
    {
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
           class="btn btn-outline-primary">
            Администрация
        </a>
    }
</div>