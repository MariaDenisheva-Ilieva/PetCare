@using PetCare.Data.Entities
@model PetCare.Web.Models.MyAppointmentsViewModel

@{
    ViewData["Title"] = "Моите часове";
    var clinicTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Sofia");
    var now = DateTimeOffset.UtcNow;
}

<h1>Моите часове</h1>

@if (TempData["AppointmentCancelled"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (TempData["AppointmentCancelError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<p>
    <a asp-controller="Veterinarians" asp-action="Index" class="btn btn-primary">
        Запази нов час
    </a>
</p>

<form asp-controller="MyAppointments" asp-action="Index" method="get" class="mb-3">
    <label asp-for="Status" class="form-label">Статус</label>
    <div class="d-flex flex-wrap gap-2">
        <select asp-for="Status" class="form-select w-auto">
            <option value="">Всички</option>
            <option value="Scheduled">Записани</option>
            <option value="Completed">Проведени</option>
            <option value="Cancelled">Отменени</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Филтрирай</button>
    </div>
</form>

@if (Model.Appointments.Count == 0)
{
    <p>Няма часове за избрания статус.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Дата и час</th>
                    <th scope="col">Любимец</th>
                    <th scope="col">Ветеринар</th>
                    <th scope="col">Причина</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    var localStart = TimeZoneInfo.ConvertTime(
                    appointment.StartsAt, clinicTimeZone);
                    var statusText = appointment.Status switch
                    {
                        AppointmentStatus.Scheduled => "Записан",
                        AppointmentStatus.Completed => "Проведен",
                        AppointmentStatus.Cancelled => "Отменен",
                        _ => "Неизвестен"
                    };

                    <tr>
                        <td>@localStart.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@appointment.Pet.Name</td>
                        <td>@appointment.Veterinarian.FirstName @appointment.Veterinarian.LastName</td>
                        <td>@appointment.Reason</td>
                        <td>@statusText</td>
                        <td>
                            @if (appointment.Status == AppointmentStatus.Scheduled &&
                                                appointment.StartsAt > now)
                            {
                                <form asp-controller="MyAppointments" asp-action="Cancel"
                                      asp-route-status="@Model.Status"
                                      asp-route-page="@Model.Page" method="post">
                                    <input type="hidden" name="id" value="@appointment.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Отмени часа
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap align-items-center gap-2" aria-label="Страници с часове">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-status="@Model.Status"
               asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">
                Предишна
            </a>
        }

        <span>Страница @Model.Page от @Model.TotalPages</span>

        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-status="@Model.Status"
               asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">
                Следваща
            </a>
        }
    </nav>
}