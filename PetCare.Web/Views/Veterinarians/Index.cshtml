@model IReadOnlyList<PetCare.Data.Entities.Veterinarian>

@{
    ViewData["Title"] = "Ветеринари";
}

<h1>Ветеринари</h1>

@if (Model.Count == 0)
{
    <p>Все още няма добавени ветеринари.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Име и фамилия</th>
                    <th scope="col">Специалност</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var veterinarian in Model)
                {
                    <tr>
                        <td>@veterinarian.FirstName @veterinarian.LastName</td>
                        <td>@(veterinarian.Specialty ?? "Непосочена")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}