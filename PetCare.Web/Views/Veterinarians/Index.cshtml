@model IReadOnlyList<PetCare.Data.Entities.Veterinarian>

@{
    ViewData["Title"] = "Ветеринари";
}

<h1>Ветеринари</h1>

@if (TempData["AppointmentSaved"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.Count == 0)
{
    <p>Все още няма добавени ветеринари.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Име и фамилия</th>
                    <th scope="col">Специалност</th>
                    <th scope="col">Записване</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var veterinarian in Model)
                {
                    <tr>
                        <td>@veterinarian.FirstName @veterinarian.LastName</td>
                        <td>@(veterinarian.Specialty ?? "Непосочена")</td>
                        <td>
                            @if (User.IsInRole("User"))
                            {
                                <a asp-controller="Appointments" asp-action="Create"
                                   asp-route-veterinarianId="@veterinarian.Id"
                                   class="btn btn-outline-primary btn-sm">Запази час</a>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login">Влез, за да запазиш час</a>
                            }
                            else
                            {
                                <span>Записване от профил на стопанин</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}