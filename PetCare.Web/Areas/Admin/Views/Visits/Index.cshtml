@using PetCare.Data.Entities
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IReadOnlyList<Appointment>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Управление на прегледите";

    var clinicTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Sofia");
    var now = DateTimeOffset.UtcNow;
}

<h1>Управление на прегледите</h1>

<p>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
       class="btn btn-outline-secondary">Назад към администрацията</a>
</p>

@if (TempData["VisitMessage"] is string message)
{
    <div class="alert alert-info" role="status">@message</div>
}

@if (Model.Count == 0)
{
    <p>Все още няма записани часове.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Дата и час</th>
                    <th scope="col">Любимец</th>
                    <th scope="col">Стопанин</th>
                    <th scope="col">Ветеринар</th>
                    <th scope="col">Причина</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    var localStart = TimeZoneInfo.ConvertTime(
                    appointment.StartsAt, clinicTimeZone);
                    var statusText = appointment.Status switch
                    {
                        AppointmentStatus.Scheduled => "Записан",
                        AppointmentStatus.Completed => "Проведен",
                        AppointmentStatus.Cancelled => "Отменен",
                        _ => "Неизвестен"
                    };

                    <tr>
                        <td>@localStart.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@appointment.Pet.Name</td>
                        <td>@appointment.Pet.Owner.FirstName @appointment.Pet.Owner.LastName</td>
                        <td>@appointment.Veterinarian.FirstName @appointment.Veterinarian.LastName</td>
                        <td>@appointment.Reason</td>
                        <td>@statusText</td>
                        <td>
                            @if (appointment.Status == AppointmentStatus.Scheduled)
                            {
                                if (appointment.StartsAt > now)
                                {
                                    <form asp-area="Admin" asp-controller="Visits"
                                          asp-action="Cancel" method="post">
                                        <input type="hidden" name="id" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Отмени часа
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-area="Admin" asp-controller="Visits"
                                          asp-action="Complete" method="post">
                                        <input type="hidden" name="id" value="@appointment.Id" />
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            Отбележи като проведен
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}